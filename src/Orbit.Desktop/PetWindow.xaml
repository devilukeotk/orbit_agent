<Window x:Class="Orbit.Desktop.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit desktop pet" Width="100" Height="112" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" MouseLeftButtonDown="MovePet">
  <StackPanel Background="Transparent">
    <StackPanel.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Show Orbit" Click="ShowOrbit" />
        <MenuItem Header="Close pet" Click="ClosePet" />
      </ContextMenu>
    </StackPanel.ContextMenu>
    <Border Width="76" Height="76" Margin="0,5,0,0" CornerRadius="28" Background="#745BFF"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform x:Name="Pulse" /></Border.RenderTransform>
      <TextBlock Text="● ●" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Border Background="#202634" CornerRadius="8" Padding="5,2" Margin="0,5,0,0" HorizontalAlignment="Center">
      <TextBlock x:Name="Status" Foreground="White" />
    </Border>
  </StackPanel>
</Window>
