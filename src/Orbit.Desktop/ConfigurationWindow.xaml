<Window x:Class="Orbit.Desktop.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit settings" Width="720" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#161A22">
  <DockPanel Margin="16">
    <TextBlock x:Name="FolderLabel" DockPanel.Dock="Top" Margin="0,0,0,10"
               Foreground="#B7C2D8" TextWrapping="Wrap" />
    <TabControl x:Name="Files">
      <TabControl.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate>
          <DockPanel Margin="10">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Instructions}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Content="Save" Padding="16,5" Click="Save_Click" />
              <TextBlock Text="{Binding Status}" Margin="0,0,8,0" VerticalAlignment="Center"
                         TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Padding="8" AutomationProperties.Name="{Binding Name}" />
          </DockPanel>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
