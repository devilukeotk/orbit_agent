<Window x:Class="Orbit.Desktop.WindowPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a window" Width="560" Height="340" MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
      <Button x:Name="FocusButton" Content="Switch" IsDefault="True" IsEnabled="False" Padding="14,6"
              Click="Choose_Click" />
    </StackPanel>
    <ListBox x:Name="Windows" DisplayMemberPath="Title" SelectionChanged="Windows_SelectionChanged"
             AutomationProperties.Name="Matching windows" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
