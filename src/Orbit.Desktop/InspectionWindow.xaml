<Window x:Class="Orbit.Desktop.InspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI inspection" Width="700" Height="480" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <TextBlock x:Name="Summary" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" />
    <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right"
            Margin="0,12,0,0" Padding="16,5" />
    <TextBox x:Name="Outline" IsReadOnly="True" FontFamily="Consolas" Padding="8"
             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="UI control tree" />
  </DockPanel>
</Window>
